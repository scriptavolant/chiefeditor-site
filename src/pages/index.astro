---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const pinnedPosts = allPosts.filter(p => p.data.pinned).sort((a,b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const recentPosts = allPosts.filter(p => !p.data.pinned).sort((a,b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 6);

// Tags cloud
const tagMap: Record<string, number> = {};
allPosts.forEach(p => p.data.tags.forEach(t => { tagMap[t] = (tagMap[t] || 0) + 1; }));
const topTags = Object.entries(tagMap).sort((a,b) => b[1]-a[1]).slice(0, 18);

// Series
const allSeries = await getCollection('series');

function formatDate(d: Date) {
  return d.toLocaleDateString('it-IT', { day:'numeric', month:'long', year:'numeric' });
}
---
<Base>

<!-- ══════════════════════════════════════════════
     HERO — Download + Video
══════════════════════════════════════════════ -->
<section class="hero">
  <div class="container hero-grid">

    <!-- LEFT: Download -->
    <div class="hero-left">
      <div class="hero-badge">
        <span class="pulse"></span>
        v1.0.7 Beta
      </div>
      <h1 class="hero-title">
        Il tuo editor<br/>
        <em>letterario</em> con AI
      </h1>
      <p class="hero-sub">
        Scrivi ogni giorno. Ricevi una critica onesta.<br/>
        Trova la tua voce letteraria.
      </p>

      <div class="download-box">
        <div class="download-label">Download gratuito — BYOK</div>
        <div class="download-btns">
          <a href="/downloads/chief-editor-setup-1.0.7.exe" class="dl-btn" download>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
            <span>
              <strong>Windows</strong>
              <small>.exe / .msi · 64-bit</small>
            </span>
          </a>
          <a href="/downloads/chief-editor-1.0.7.dmg" class="dl-btn" download>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v18m0 0h10a2 2 0 0 0 2-2v-4M9 21H5a2 2 0 0 1-2-2v-4m0 0h18"/></svg>
            <span>
              <strong>macOS</strong>
              <small>.dmg · Intel & Apple Silicon</small>
            </span>
          </a>
          <a href="/downloads/chief-editor-1.0.7.AppImage" class="dl-btn" download>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="m4.93 4.93 14.14 14.14"/></svg>
            <span>
              <strong>Linux</strong>
              <small>.AppImage / .deb · x64</small>
            </span>
          </a>
        </div>
        <p class="download-note">
          Richiede chiave API Anthropic · <a href="/aiuto#byok">Cos'è BYOK?</a>
        </p>
      </div>
    </div>

    <!-- RIGHT: Video -->
    <div class="hero-right">
      <div class="video-frame">
        <div class="video-glow"></div>
        <iframe
          src="https://www.youtube.com/embed/dQw4w9WgXcQ"
          title="Chief Editor — presentazione"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          loading="lazy"
        ></iframe>
      </div>
      <div class="donate-box">
        <a href="https://www.paypal.com/donate?hosted_button_id=YOUR_PAYPAL_BUTTON_ID" class="donate-btn" target="_blank" rel="noopener">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M7.076 21.337H2.47a.641.641 0 0 1-.633-.74L4.944.901C5.026.382 5.474 0 5.998 0h7.46c2.57 0 4.578.543 5.622 1.566 1.035.974 1.481 2.408 1.34 3.948-.173 1.92-.98 3.181-2.19 4.15-.883.712-1.988 1.19-3.087 1.565-1.827.625-3.691 1.062-5.173 1.514-.264.081-.521.15-.767.21a.64.64 0 0 1-.267 0c-.265-.06-.522-.129-.767-.21-1.482-.452-3.346-.889-5.173-1.514-1.099-.375-2.204-.853-3.087-1.565C.645 6.615-.162 5.354 0 3.434.141 1.894.587.46 1.622.486 2.666.512 4.674.055 7.244.055h7.46c.524 0 .972.382 1.054.901l3.107 19.696a.641.641 0 0 1-.633.74H16.92c-.446 0-.84-.37-.934-.813a.638.638 0 0 1 .063-.362l1.348-6.956c.042-.216.055-.333.055-.333.117-.665.117-1.176 0-1.519-.426-1.235-1.744-1.635-3.146-1.635h-4.49c-.45 0-.84.37-.934.813a.638.638 0 0 1 .063.362l1.348 6.956c.042.216.055.333.055.333.117.665.117 1.176 0 1.519-.426 1.235-1.744 1.635-3.146 1.635H7.076z"/>
          </svg>
          Supporta il progetto
        </a>
      </div>
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════════
     INTRO TEXT
══════════════════════════════════════════════ -->
<section class="intro">
  <div class="container intro-inner">
    <div class="intro-line"></div>
    <div class="intro-text">
      <p>
        Benvenuto nella redazione di <strong>Chief Editor</strong>, un blog che racconta il dietro le quinte della nascita e dello sviluppo di Chief Editor, il primo personal editor basato sull'intelligenza artificiale. Come nasce, perché, come si sviluppa, come usarlo in maniera creativa. Ma parleremo anche di scrittura, routine letteraria, scuole, editoria, libri, autori, insomma tutto ciò che fa la letteratura dalle origini dell'uomo al futuro ancora da scrivere.
      </p>
      <p class="intro-cta-text">
        Intanto se lo vuoi testare, <a href="/download">scarica la versione beta v1.0.7</a>.
      </p>
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════════
     PINNED POSTS
══════════════════════════════════════════════ -->
{pinnedPosts.length > 0 && (
  <section class="section pinned-section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">📌 In evidenza</h2>
      </div>
      <div class="pinned-grid">
        {pinnedPosts.map(post => (
          <article class="pinned-card">
            {post.data.heroImage && (
              <img src={post.data.heroImage} alt="" class="pinned-img" loading="lazy" />
            )}
            <div class="pinned-body">
              {post.data.series && (
                <span class="post-series">{post.data.series}</span>
              )}
              <h3 class="pinned-title">
                <a href={`/blog/${post.slug}`}>{post.data.title}</a>
              </h3>
              <p class="pinned-desc">{post.data.description}</p>
              <div class="post-meta">
                <time>{formatDate(post.data.pubDate)}</time>
                {post.data.tags.slice(0,2).map(t => (
                  <a href={`/tag/${t}`} class="tag">{t}</a>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

<!-- ══════════════════════════════════════════════
     RECENT POSTS
══════════════════════════════════════════════ -->
<section class="section posts-section">
  <div class="container posts-layout">

    <!-- POSTS -->
    <div class="posts-main">
      <div class="section-header">
        <h2 class="section-title">Ultimi articoli</h2>
        <a href="/blog" class="section-more">Vedi tutti →</a>
      </div>
      {recentPosts.length === 0 && (
        <p class="empty-state">Nessun post ancora. In arrivo presto.</p>
      )}
      <div class="posts-list">
        {recentPosts.map(post => (
          <article class="post-card">
            <div class="post-card-meta">
              <time>{formatDate(post.data.pubDate)}</time>
              {post.data.series && (
                <a href={`/serie/${post.data.series.toLowerCase().replace(/\s+/g,'-')}`} class="post-series">
                  {post.data.series}
                </a>
              )}
            </div>
            <h3 class="post-card-title">
              <a href={`/blog/${post.slug}`}>{post.data.title}</a>
            </h3>
            <p class="post-card-desc">{post.data.description}</p>
            <div class="post-card-tags">
              {post.data.tags.map(t => (
                <a href={`/tag/${t}`} class="tag">{t}</a>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>

    <!-- SIDEBAR -->
    <aside class="posts-sidebar">

      <!-- Tags -->
      {topTags.length > 0 && (
        <div class="sidebar-widget">
          <h3 class="widget-title">Tag</h3>
          <div class="tag-cloud">
            {topTags.map(([tag, count]) => (
              <a href={`/tag/${tag}`} class="tag" title={`${count} articoli`}>{tag}</a>
            ))}
          </div>
        </div>
      )}

      <!-- Series -->
      {allSeries.length > 0 && (
        <div class="sidebar-widget">
          <h3 class="widget-title">Serie</h3>
          <ul class="series-list" role="list">
            {allSeries.sort((a,b) => a.data.order - b.data.order).map(s => {
              const count = allPosts.filter(p => p.data.series === s.data.title).length;
              return (
                <li>
                  <a href={`/serie/${s.slug}`} class="series-item">
                    <span class="series-dot" style={`background:${s.data.color}`}></span>
                    <span class="series-info">
                      <strong>{s.data.title}</strong>
                      <small>{count} {count === 1 ? 'articolo' : 'articoli'}</small>
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      )}

      <!-- Download mini -->
      <div class="sidebar-widget sidebar-download">
        <h3 class="widget-title">⬇ Download</h3>
        <p>Chief Editor Beta v1.0.7 — disponibile per Windows, macOS e Linux.</p>
        <a href="/download" class="sidebar-dl-btn">Scarica ora — è gratis</a>
      </div>

    </aside>

  </div>
</section>

</Base>

<style>
/* ── HERO ── */
.hero {
  padding: 5rem 0 4rem;
  position: relative;
  overflow: hidden;
}
.hero::before {
  content: '';
  position: absolute;
  top: -200px;
  left: 50%;
  transform: translateX(-50%);
  width: 800px;
  height: 600px;
  background: radial-gradient(ellipse, rgba(124,58,237,0.12) 0%, transparent 70%);
  pointer-events: none;
}
.hero-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3.5rem;
  align-items: center;
}
.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(245,158,11,0.1);
  border: 1px solid rgba(245,158,11,0.25);
  color: var(--gold);
  border-radius: 20px;
  padding: 4px 12px;
  font-size: 0.775rem;
  font-weight: 600;
  letter-spacing: 0.04em;
  margin-bottom: 1.25rem;
}
.pulse {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--gold);
  animation: pulse 2s ease infinite;
}
@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.5; transform: scale(1.4); }
}
.hero-title {
  font-size: clamp(2.2rem, 4vw, 3.5rem);
  font-weight: 900;
  line-height: 1.05;
  color: var(--text);
  margin-bottom: 1rem;
  letter-spacing: -0.03em;
}
.hero-title em {
  color: var(--vio3);
  font-style: italic;
}
.hero-sub {
  font-size: 1.05rem;
  color: var(--sub);
  line-height: 1.65;
  margin-bottom: 2rem;
}

/* Download box */
.download-box {
  background: var(--surf);
  border: 1px solid var(--border2);
  border-radius: 16px;
  padding: 1.5rem;
}
.download-label {
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--sub);
  margin-bottom: 1rem;
}
.download-btns {
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
  margin-bottom: 1rem;
}
.dl-btn {
  display: flex;
  align-items: center;
  gap: 0.85rem;
  background: var(--surf2);
  border: 1px solid var(--border2);
  border-radius: 10px;
  padding: 0.75rem 1rem;
  text-decoration: none;
  transition: all 0.2s;
  color: var(--text);
}
.dl-btn:hover {
  background: rgba(124,58,237,0.1);
  border-color: rgba(196,181,253,0.3);
  color: var(--vio3);
  transform: translateX(3px);
}
.dl-btn svg { color: var(--vio3); flex-shrink: 0; }
.dl-btn span { display: flex; flex-direction: column; gap: 1px; }
.dl-btn strong { font-size: 0.9rem; font-weight: 600; }
.dl-btn small { font-size: 0.75rem; color: var(--sub); }
.dl-btn:hover small { color: var(--vio3); opacity: 0.7; }
.download-note {
  font-size: 0.775rem;
  color: var(--sub);
  margin: 0;
}
.download-note a { color: var(--vio3); }

/* Video */
.hero-right { position: relative; }
.video-frame {
  position: relative;
  border-radius: 14px;
  overflow: hidden;
  border: 1px solid var(--border2);
  background: var(--surf);
  aspect-ratio: 16/9;
}
.video-glow {
  position: absolute;
  inset: -2px;
  border-radius: 16px;
  background: linear-gradient(135deg, rgba(124,58,237,0.4), rgba(144,97,249,0.1));
  z-index: -1;
  filter: blur(16px);
}
.video-frame iframe {
  width: 100%;
  height: 100%;
  border: none;
  display: block;
}
.donate-box {
  margin-top: 1.25rem;
  text-align: center;
}
.donate-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  background: #0070ba;
  color: #fff;
  border-radius: 8px;
  padding: 0.6rem 1.2rem;
  font-size: 0.875rem;
  font-weight: 600;
  text-decoration: none;
  transition: opacity 0.2s;
}
.donate-btn:hover {
  opacity: 0.88;
  color: #fff;
}

/* ── INTRO ── */
.intro {
  padding: 2.5rem 0 3rem;
  border-bottom: 1px solid var(--border);
}
.intro-inner {
  display: flex;
  gap: 2.5rem;
  align-items: flex-start;
}
.intro-line {
  width: 3px;
  min-height: 80px;
  background: linear-gradient(to bottom, var(--vio), transparent);
  border-radius: 2px;
  flex-shrink: 0;
  margin-top: 4px;
}
.intro-text p {
  color: var(--text2);
  font-size: 1.0625rem;
  line-height: 1.8;
  margin-bottom: 0.75rem;
}
.intro-text strong { color: var(--text); }
.intro-cta-text { font-size: 1rem; }
.intro-cta-text a { color: var(--vio3); font-weight: 500; }
.intro-cta-text a:hover { color: var(--vio4); }

/* ── SECTIONS ── */
.section { padding: 4rem 0; }
.section-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 1.75rem;
}
.section-title {
  font-family: var(--font-serif);
  font-size: 1.5rem;
  color: var(--text);
  font-weight: 700;
}
.section-more {
  font-size: 0.875rem;
  color: var(--vio3);
  font-weight: 500;
}

/* ── PINNED ── */
.pinned-section { background: var(--bg2); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
.pinned-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: 1.25rem;
}
.pinned-card {
  background: var(--surf);
  border: 1px solid var(--border2);
  border-radius: 14px;
  overflow: hidden;
  transition: border-color 0.2s, transform 0.2s;
}
.pinned-card:hover { border-color: rgba(196,181,253,0.3); transform: translateY(-2px); }
.pinned-img { width: 100%; height: 180px; object-fit: cover; }
.pinned-body { padding: 1.25rem; }
.pinned-title { font-size: 1.1rem; margin-bottom: 0.5rem; line-height: 1.3; }
.pinned-title a { color: var(--text); text-decoration: none; }
.pinned-title a:hover { color: var(--vio3); }
.pinned-desc { font-size: 0.875rem; color: var(--sub); line-height: 1.6; margin-bottom: 0.75rem; }

/* ── POSTS LAYOUT ── */
.posts-layout {
  display: grid;
  grid-template-columns: 1fr 300px;
  gap: 3rem;
  align-items: start;
}
.posts-list { display: flex; flex-direction: column; gap: 0; }

/* Post card */
.post-card {
  padding: 1.5rem 0;
  border-bottom: 1px solid var(--border);
  transition: background 0.15s;
}
.post-card:first-child { padding-top: 0; }
.post-card-meta {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin-bottom: 0.5rem;
}
.post-card-meta time { font-size: 0.8rem; color: var(--sub); }
.post-series {
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--vio3);
  background: rgba(124,58,237,0.1);
  border-radius: 20px;
  padding: 1px 9px;
  text-decoration: none;
  border: 1px solid rgba(196,181,253,0.15);
}
.post-card-title { font-size: 1.2rem; margin-bottom: 0.4rem; font-weight: 700; line-height: 1.3; }
.post-card-title a { color: var(--text); text-decoration: none; }
.post-card-title a:hover { color: var(--vio3); }
.post-card-desc { font-size: 0.875rem; color: var(--sub); line-height: 1.65; margin-bottom: 0.75rem; }
.post-card-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; }

/* Meta shared */
.post-meta {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  flex-wrap: wrap;
}
.post-meta time { font-size: 0.8rem; color: var(--sub); }

/* ── SIDEBAR ── */
.sidebar-widget {
  background: var(--surf);
  border: 1px solid var(--border2);
  border-radius: 12px;
  padding: 1.25rem;
  margin-bottom: 1.25rem;
}
.widget-title {
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--sub);
  margin-bottom: 1rem;
  font-family: var(--font-sans);
}
.tag-cloud { display: flex; flex-wrap: wrap; gap: 0.4rem; }
.series-list { list-style: none; display: flex; flex-direction: column; gap: 0.4rem; }
.series-item {
  display: flex;
  align-items: center;
  gap: 0.7rem;
  padding: 0.5rem 0.6rem;
  border-radius: 8px;
  text-decoration: none;
  transition: background 0.15s;
}
.series-item:hover { background: var(--surf2); }
.series-dot { width: 9px; height: 9px; border-radius: 50%; flex-shrink: 0; }
.series-info { display: flex; flex-direction: column; }
.series-info strong { font-size: 0.875rem; color: var(--text); }
.series-info small { font-size: 0.75rem; color: var(--sub); }
.sidebar-download p { font-size: 0.85rem; color: var(--sub); margin-bottom: 0.85rem; line-height: 1.55; }
.sidebar-dl-btn {
  display: block;
  text-align: center;
  background: linear-gradient(135deg, var(--vio), var(--vio2));
  color: #fff;
  border-radius: 8px;
  padding: 0.6rem 1rem;
  font-size: 0.875rem;
  font-weight: 600;
  text-decoration: none;
  transition: opacity 0.2s;
}
.sidebar-dl-btn:hover { opacity: 0.88; color: #fff; }

.empty-state { color: var(--sub); font-style: italic; padding: 2rem 0; }

/* ── Responsive ── */
@media (max-width: 900px) {
  .hero-grid { grid-template-columns: 1fr; }
  .hero-right { order: -1; }
  .posts-layout { grid-template-columns: 1fr; }
  .posts-sidebar { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
}
@media (max-width: 600px) {
  .hero { padding: 3rem 0 2.5rem; }
  .posts-sidebar { grid-template-columns: 1fr; }
  .intro-inner { flex-direction: column; gap: 1rem; }
  .intro-line { width: 40px; height: 3px; min-height: unset; background: linear-gradient(to right, var(--vio), transparent); }
}
</style>
