---
import Base from "../layouts/Base.astro";

const tickerItems = [
  "750 parole al giorno",
  "Tua proprietà intellettuale",
  "8 archetipi letterari",
  "Timer e Pomodoro integrati",
  "Critica di qualità professionale",
  "Dal diario all'opera strutturata",
  "Privacy GDPR garantita",
  "Streak quotidiana e statistiche",
];

const features = [
  {
    icon: "📖",
    title: "Critica letteraria AI",
    desc: "Score 1-10 su voce, stile, immaginario, temi e risonanza filosofica. Come un editor professionista, ogni giorno.",
    tag: "Chief Editor",
    color: "#7c6af7",
  },
  {
    icon: "🎭",
    title: "Profilo e archetipo",
    desc: "Otto archetipi letterari. L'AI impara chi sei come scrittore e calibra ogni analisi sulla tua voce specifica.",
    tag: "Identità",
    color: "#e8c84a",
  },
  {
    icon: "📚",
    title: "Opere strutturate",
    desc: "Romanzi, saggi, raccolte. Opera, capitoli e sezioni: assegna i testi del diario direttamente ai tuoi manoscritti.",
    tag: "Long-form",
    color: "#4ade80",
  },
  {
    icon: "⏱️",
    title: "Timer e Pomodoro",
    desc: "Scrivi con focus totale: countdown personalizzabile e tecnica Pomodoro integrata. Misura ogni minuto di scrittura.",
    tag: "Focus",
    color: "#60a5fa",
  },
  {
    icon: "📊",
    title: "Statistiche complete",
    desc: "Streak, score nel tempo, tempo di scrittura e distribuzione degli umori. Vedi la crescita sessione per sessione.",
    tag: "Crescita",
    color: "#e879f9",
  },
  {
    icon: "🔒",
    title: "Privacy assoluta",
    desc: "I tuoi testi appartengono solo a te. Nessuno li legge. GDPR compliant. Proprietà intellettuale garantita.",
    tag: "Privacy",
    color: "#5eead4",
  },
];

const audience = [
  {
    emoji: "✍️",
    who: "Aspiranti scrittori",
    cosa: 'Hai un romanzo in testa da anni. 750 parole al giorno trasformano quel "prima o poi" in 270.000 parole in un anno.',
    grad: "linear-gradient(135deg,#7c6af7,#a78bfa)",
  },
  {
    emoji: "📔",
    who: "Diaristi",
    cosa: "Il diario che legge tra le righe, capisce il tuo mondo interiore e cresce con te sessione dopo sessione.",
    grad: "linear-gradient(135deg,#e8c84a,#f5d76e)",
  },
  {
    emoji: "📗",
    who: "Autori emergenti",
    cosa: "Un editor AI sempre disponibile. Analisi critica di qualità professionale a una frazione del costo tradizionale.",
    grad: "linear-gradient(135deg,#4ade80,#22c55e)",
  },
  {
    emoji: "🖊️",
    who: "Professionisti creativi",
    cosa: "Sviluppa uno stile riconoscibile. Chief Editor impara chi sei come scrittore e calibra ogni suggerimento su di te.",
    grad: "linear-gradient(135deg,#e879f9,#a78bfa)",
  },
];

const steps = [
  {
    n: "1",
    title: "Scegli e scrivi",
    body: "Seleziona una categoria, leggi il prompt AI personalizzato. Poi scrivi liberamente, senza correggere, senza fermarti.",
  },
  {
    n: "2",
    title: "Ricevi la critica",
    body: "Il Chief Editor legge il testo, assegna uno score su cinque dimensioni e propone riferimenti, nota editoriale ed esercizio.",
  },
  {
    n: "3",
    title: "Costruisci l'opera",
    body: "Assegna i testi migliori ai capitoli del romanzo. Dal diario quotidiano al manoscritto compiuto.",
  },
];

const scoreInsights = [
  ["🗣️", "Voce narrativa", "Riconoscibile e autentica tra mille altre"],
  ["✒️", "Stile e ritmo", "Coerenza lessicale, musica della prosa"],
  ["🔭", "Risonanza filosofica", "La capacità di toccare domande universali"],
];

const scoreBars = [
  ["Voce narrativa", 82, "#7c6af7"],
  ["Stile", 71, "#e8c84a"],
  ["Immaginario", 76, "#e879f9"],
  ["Temi", 68, "#60a5fa"],
  ["Risonanza filos.", 74, "#4ade80"],
];
---

<Base
  title="Chief Editor"
  description="Scrivi ogni giorno, ricevi critica letteraria AI e trasforma il diario in un'opera strutturata."
>
  <section class="landing-hero">
    <div class="container hero-shell">
      <div class="hero-copy">
        <p class="eyebrow"><span></span>Il tuo editor letterario con AI</p>
        <h1>
          Scrivi ogni giorno.
          <em>La tua voce</em>
          diventa un'opera.
        </h1>
        <p class="hero-sub">
          750 parole al giorno. Un editor AI che capisce la tua identità
          letteraria. Dal frammento di diario al romanzo compiuto.
        </p>
        <div class="hero-actions" aria-label="Azioni principali">
          <a class="btn btn-primary" href="/download">Download Beta</a>
          <a class="btn btn-secondary" href="/aiuto">Scopri come funziona</a>
        </div>
        <div class="hero-proof">
          <span>Score e analisi DNA letterario</span>
          <span>Privacy totale sui testi</span>
          <span>AI calibrata sulla tua voce</span>
        </div>
      </div>

      <div class="hero-product" aria-label="Anteprima Chief Editor">
        <iframe
          src="https://www.youtube.com/embed/NDG6klk7tMI"
          title="Chief Editor - presentazione"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
          loading="eager"></iframe>
      </div>
    </div>
  </section>

  <section class="ticker" aria-label="Punti chiave">
    <div class="ticker-fade ticker-fade-left"></div>
    <div class="ticker-fade ticker-fade-right"></div>
    <div class="ticker-track">
      {[...tickerItems, ...tickerItems].map((item) => (
        <span class="ticker-item"><b>✦</b>{item}</span>
      ))}
    </div>
  </section>

  <section class="product-section features-section">
    <div class="container">
      <div class="section-kicker">Funzionalità</div>
      <h2>Un editor che <em>ti conosce davvero.</em></h2>
      <div class="feature-grid">
        {features.map((feature) => (
          <article class="feature-card">
            <div class="feature-icon">{feature.icon}</div>
            <h3>{feature.title}</h3>
            <p>{feature.desc}</p>
            <span class="feature-tag" style={`--tag-color:${feature.color}`}>{feature.tag}</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="product-section audience-section">
    <div class="container">
      <div class="section-kicker">Per chi è Chief Editor</div>
      <h2>Chiunque abbia <em>qualcosa da dire.</em></h2>
      <div class="audience-grid">
        {audience.map((item) => (
          <article class="audience-card" style={`--card-line:${item.grad}`}>
            <span class="audience-line"></span>
            <div class="audience-emoji">{item.emoji}</div>
            <h3>{item.who}</h3>
            <p>{item.cosa}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="product-section steps-section">
    <div class="container steps-container">
      <div class="section-kicker">Come funziona</div>
      <h2>Tre passi. <em>Ogni giorno.</em></h2>
      <div class="steps-grid">
        <span class="steps-line" aria-hidden="true"></span>
        {steps.map((step) => (
          <article class="step-card">
            <div class="step-number">{step.n}</div>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="product-section score-section">
    <div class="container score-grid">
      <div class="score-copy">
        <div class="section-kicker">Lo score Chief Editor</div>
        <h2>Lo score che <em>misura la crescita.</em></h2>
        <p class="score-lead">
          Da 1 a 10 su cinque dimensioni letterarie. Non misura la grammatica:
          misura quanto sei diventato scrittore.
        </p>
        <div class="score-insights">
          {scoreInsights.map(([icon, title, text]) => (
            <article class="score-insight">
              <div>{icon}</div>
              <span>
                <strong>{title}</strong>
                <small>{text}</small>
              </span>
            </article>
          ))}
        </div>
      </div>

      <div class="score-panel">
        <div class="score-panel-head">
          <div>
            <span>Chief Editor Score</span>
            <small>sessione del 12 marzo</small>
          </div>
          <div class="score-value">
            <strong>7.4</strong>
            <small>/10</small>
          </div>
        </div>
        <div class="score-bars">
          {scoreBars.map(([label, value, color]) => (
            <div class="score-row" style={`--bar:${color}; --value:${value}%`}>
              <span>{label}</span>
              <div class="score-bar"><i></i></div>
              <b>{(Number(value) / 10).toFixed(1)}</b>
            </div>
          ))}
        </div>
        <blockquote>
          “Una scrittura che abita il margine tra il ricordo e il sogno.
          Fidarsi della voce senza giustificarsi.”
        </blockquote>
      </div>
    </div>
  </section>

  <section class="product-section graph-section">
    <div class="container graph-grid">
      <div>
        <div class="section-kicker">Profilo letterario</div>
        <h2>La tua voce dentro una <em>mappa viva.</em></h2>
        <p>
          Chief Editor collega archetipi, influenze e autori adiacenti per
          restituirti una lettura sempre più precisa del tuo percorso.
        </p>
      </div>
      <img src="/grafo.png" alt="Grafo degli autori affini in Chief Editor" loading="lazy" />
    </div>
  </section>
</Base>

<style>
  .landing-hero {
    padding: 5.5rem 0 4.5rem;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    background:
      linear-gradient(180deg, rgba(124, 58, 237, 0.08), transparent 42%),
      var(--bg);
  }

  .hero-shell {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(360px, 1.05fr);
    gap: 4rem;
    align-items: center;
  }

  .eyebrow,
  .section-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
    color: var(--vio3);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .eyebrow span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--vio3);
    box-shadow: 0 0 18px rgba(196, 181, 253, 0.75);
  }

  .hero-copy h1,
  .product-section h2 {
    max-width: 760px;
    color: var(--text);
    font-size: clamp(2.7rem, 6vw, 5.5rem);
    font-weight: 900;
    line-height: 1.02;
    letter-spacing: -0.02em;
  }

  .hero-copy h1 em,
  .product-section h2 em {
    display: block;
    color: var(--vio3);
    font-style: italic;
  }

  .hero-sub {
    max-width: 620px;
    margin: 1.4rem 0 0;
    color: var(--text2);
    font-family: var(--font-serif);
    font-size: clamp(1.08rem, 2vw, 1.45rem);
    font-style: italic;
    line-height: 1.65;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    border-radius: 10px;
    padding: 0.78rem 1.35rem;
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.2s, opacity 0.2s, border-color 0.2s;
  }

  .btn:hover {
    transform: translateY(-2px);
  }

  .btn-primary {
    background: linear-gradient(135deg, var(--vio), var(--vio2));
    color: #fff;
    box-shadow: 0 12px 34px rgba(124, 58, 237, 0.35);
  }

  .btn-primary:hover {
    color: #fff;
    opacity: 0.92;
  }

  .btn-secondary {
    border: 1px solid rgba(196, 181, 253, 0.22);
    background: rgba(124, 58, 237, 0.08);
    color: var(--vio4);
  }

  .hero-proof {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem 1.4rem;
    margin-top: 1.8rem;
    color: var(--sub);
    font-size: 0.92rem;
  }

  .hero-proof span {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .hero-proof span::before {
    content: "";
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--vio3);
  }

  .hero-product {
    border: 1px solid rgba(196, 181, 253, 0.2);
    border-radius: 16px;
    background: var(--surf);
    padding: 0.75rem;
    box-shadow: 0 26px 70px rgba(0, 0, 0, 0.38);
  }

  .hero-product iframe {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
    border-radius: 10px;
  }

  .graph-grid img {
    width: 100%;
    border-radius: 10px;
    border: 1px solid var(--border2);
  }

  .ticker {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    background: var(--surf);
    padding: 1rem 0;
  }

  .ticker-track {
    display: flex;
    width: max-content;
    gap: 3.2rem;
    animation: tickerScroll 28s linear infinite;
  }

  .ticker-item {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    white-space: nowrap;
    color: var(--text2);
    font-family: var(--font-serif);
    font-size: 1.05rem;
  }

  .ticker-item b {
    color: var(--vio3);
    font-size: 0.78rem;
  }

  .ticker-fade {
    position: absolute;
    top: 0;
    bottom: 0;
    z-index: 2;
    width: 72px;
    pointer-events: none;
  }

  .ticker-fade-left {
    left: 0;
    background: linear-gradient(90deg, var(--surf), transparent);
  }

  .ticker-fade-right {
    right: 0;
    background: linear-gradient(270deg, var(--surf), transparent);
  }

  @keyframes tickerScroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  .product-section {
    padding: 5.5rem 0;
  }

  .product-section h2 {
    font-size: clamp(2rem, 4vw, 3.25rem);
    margin-bottom: 1rem;
  }

  .features-section,
  .steps-section,
  .graph-section {
    background: var(--bg);
  }

  .audience-section,
  .score-section {
    background: var(--bg2);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 2.8rem;
    border: 1px solid rgba(196, 181, 253, 0.18);
    border-radius: 14px;
    overflow: hidden;
    background: rgba(196, 181, 253, 0.12);
    gap: 1px;
  }

  .feature-card {
    min-height: 280px;
    padding: 2rem;
    background: var(--bg);
    transition: background 0.2s;
  }

  .feature-card:hover {
    background: var(--surf);
  }

  .feature-icon {
    margin-bottom: 1rem;
    font-size: 1.8rem;
  }

  .feature-card h3,
  .audience-card h3,
  .step-card h3 {
    margin-bottom: 0.55rem;
    color: var(--text);
    font-size: 1.28rem;
  }

  .feature-card p,
  .audience-card p,
  .step-card p,
  .graph-grid p {
    color: var(--text2);
    font-size: 1rem;
    line-height: 1.75;
  }

  .feature-tag {
    display: inline-flex;
    margin-top: 1rem;
    border-radius: 999px;
    padding: 0.18rem 0.62rem;
    background: color-mix(in srgb, var(--tag-color) 14%, transparent);
    color: var(--tag-color);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .audience-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 2.8rem;
  }

  .audience-card {
    position: relative;
    overflow: hidden;
    min-height: 300px;
    border: 1px solid rgba(196, 181, 253, 0.17);
    border-radius: 14px;
    background: var(--surf2);
    padding: 1.6rem;
    transition: transform 0.22s, box-shadow 0.22s;
  }

  .audience-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 44px rgba(0, 0, 0, 0.32);
  }

  .audience-line {
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    background: var(--card-line);
  }

  .audience-emoji {
    margin: 0.4rem 0 1rem;
    font-size: 2rem;
  }

  .steps-container {
    text-align: center;
  }

  .steps-container h2 {
    margin-left: auto;
    margin-right: auto;
  }

  .steps-grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.2rem;
    margin-top: 3rem;
  }

  .steps-line {
    position: absolute;
    top: 28px;
    left: 17%;
    right: 17%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--vio3), transparent);
  }

  .step-card {
    position: relative;
    z-index: 1;
    padding: 0 1.5rem;
  }

  .step-number {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    margin: 0 auto 1.2rem;
    border: 2px solid var(--vio3);
    border-radius: 50%;
    background: var(--surf);
    color: var(--vio3);
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 900;
    box-shadow: 0 0 24px rgba(124, 58, 237, 0.25);
  }

  .score-grid,
  .graph-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(360px, 0.95fr);
    gap: 4rem;
    align-items: center;
  }

  .score-lead {
    max-width: 620px;
    color: var(--text2);
    font-size: 1.18rem;
    line-height: 1.8;
  }

  .score-insights {
    display: grid;
    gap: 0.7rem;
    margin-top: 1.6rem;
  }

  .score-insight {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
    border: 1px solid rgba(196, 181, 253, 0.15);
    border-radius: 10px;
    background: rgba(124, 58, 237, 0.05);
    padding: 0.85rem;
  }

  .score-insight div {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    flex: 0 0 38px;
    border-radius: 9px;
    background: rgba(124, 58, 237, 0.14);
    font-size: 1.3rem;
  }

  .score-insight span {
    display: grid;
    gap: 0.1rem;
  }

  .score-insight strong {
    color: var(--text);
    font-size: 0.98rem;
  }

  .score-insight small {
    color: var(--text2);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .score-panel {
    border: 1px solid rgba(196, 181, 253, 0.18);
    border-radius: 14px;
    background: var(--surf2);
    padding: 1.5rem;
  }

  .score-panel-head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: flex-start;
    margin-bottom: 1.2rem;
  }

  .score-panel-head span {
    display: block;
    color: var(--text2);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .score-panel-head small {
    color: var(--sub);
  }

  .score-value {
    text-align: right;
  }

  .score-value strong {
    display: block;
    color: #e8c84a;
    font-family: var(--font-serif);
    font-size: 3rem;
    line-height: 0.95;
  }

  .score-row {
    display: grid;
    grid-template-columns: 118px 1fr 34px;
    gap: 0.65rem;
    align-items: center;
    margin-bottom: 0.7rem;
  }

  .score-row span,
  .score-row b {
    color: var(--text2);
    font-size: 0.88rem;
    font-weight: 500;
  }

  .score-row b {
    text-align: right;
  }

  .score-bar {
    height: 6px;
    overflow: hidden;
    border-radius: 99px;
    background: rgba(255, 255, 255, 0.07);
  }

  .score-bar i {
    display: block;
    width: var(--value);
    height: 100%;
    border-radius: inherit;
    background: var(--bar);
  }

  .score-panel blockquote {
    margin-top: 1.2rem;
    border: 1px solid rgba(196, 181, 253, 0.16);
    border-radius: 10px;
    background: rgba(124, 58, 237, 0.08);
    padding: 0.9rem 1rem;
    color: var(--vio3);
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-style: italic;
    line-height: 1.6;
  }

  .graph-grid p {
    max-width: 560px;
    font-size: 1.12rem;
  }

  @media (max-width: 980px) {
    .hero-shell,
    .score-grid,
    .graph-grid {
      grid-template-columns: 1fr;
      gap: 2.8rem;
    }

    .hero-product {
      max-width: 720px;
    }

    .feature-grid,
    .steps-grid {
      grid-template-columns: 1fr;
    }

    .feature-card {
      min-height: unset;
    }

    .audience-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .steps-line {
      display: none;
    }

    .step-card {
      padding: 0;
    }
  }

  @media (max-width: 640px) {
    .landing-hero,
    .product-section {
      padding: 3.5rem 0;
    }

    .hero-shell {
      gap: 2rem;
    }

    .hero-actions,
    .btn {
      width: 100%;
    }

    .hero-proof {
      gap: 0.7rem;
    }

    .audience-grid {
