---
import Base from '../layouts/Base.astro';
const sections = [
  {id:"start",e:"✨",t:"Come iniziare",items:[
    {h:"Il diario quotidiano",b:"Scrivi almeno 750 parole ogni giorno. Scegli una categoria, clicca INIZIA A SCRIVERE e scrivi liberamente. Il testo viene salvato automaticamente ogni 1,2 secondi."},
    {h:"La streak",b:"La fiamma 🔥 mostra i giorni consecutivi in cui hai completato l'obiettivo di 750 parole. Si interrompe se salti un giorno intero."},
    {h:"Versioning",b:"Dopo 20 parole puoi salvare una versione del testo. Ogni versione è uno snapshot numerato con timestamp. Consultabile nell'Archivio."},
  ]},
  {id:"ai",e:"📖",t:"Chief Editor AI",items:[
    {h:"Critica letteraria",b:"Dopo 50 parole appaiono gli strumenti AI. La critica analizza: voce narrativa, stile, immaginario, temi, risonanza filosofica. Score da 1 a 10."},
    {h:"Tipologia del testo",b:"Seleziona la tipologia del testo (Diario, Racconto breve, Articolo/Saggio, Long read, Romanzo) prima di avviare la critica. Il Chief Editor adatta i criteri di valutazione alla forma."},
    {h:"Lo score 1-10",b:"Valuta 5 dimensioni: voce narrativa, stile, immaginario, temi, risonanza filosofica. Un 7 è già un risultato solido. Lo score è calibrato sulla tipologia del testo."},
    {h:"Verifica revisione",b:"Dopo una critica, riscrivi il testo e clicca Verifica revisione. Il Chief Editor confronta originale e revisione mostrando il delta di miglioramento."},
    {h:"Analisi umore",b:"Identifica il tono emotivo (Gioioso, Sereno, Riflessivo, Malinconico, Ansioso, Energico, Nostalgico, Neutro), energia 1-10, parole chiave e un suggerimento."},
  ]},
  {id:"profilo",e:"🎭",t:"Profilo Letterario",items:[
    {h:"A cosa serve",b:"Calibra tutte le analisi AI sulla tua identità di scrittore. Con il profilo il Chief Editor conosce il tuo stile, i tuoi riferimenti e le tue aspirazioni."},
    {h:"Come costruirlo",b:"Scegli fino a 3 generi, inserisci fino a 10 autori e 5 titoli preferiti. L'AI genera archetipo, DNA stilistico, correnti filosofiche e percorso di crescita."},
    {h:"Gli 8 archetipi",b:"Lo Scrutatore dell'Anima · Il Cronista Visionario · Il Narratore Epico · Il Poeta del Quotidiano · Il Filosofo Nascosto · Il Testimone Empatico · Il Visionario Simbolico · Il Costruttore di Mondi"},
    {h:"Goodreads",b:"Esporta la lista libri (My Books → Export CSV) e incolla il contenuto nel profilo. L'AI analizza le tue letture e arricchisce il profilo."},
  ]},
  {id:"byok",e:"🔑",t:"BYOK — Bring Your Own Key",items:[
    {h:"Cos'è il modello BYOK",b:"Chief Editor Desktop non ha un server centrale. Ogni analisi viaggia direttamente dal tuo computer ai provider AI che hai configurato. Paghi solo quello che usi."},
    {h:"Provider supportati",b:"Anthropic Claude (consigliato per la critica letteraria) · OpenAI GPT-4o · DeepSeek · Google Gemini. Puoi usarne uno solo o tutti e quattro."},
    {h:"Come ottenere le chiavi",b:"Anthropic: console.anthropic.com → API Keys → Create Key. OpenAI: platform.openai.com → API Keys. Google: aistudio.google.com → Get API key."},
    {h:"Dove vengono salvate",b:"Le chiavi sono salvate localmente in ~/ChiefEditor/_config.json. Non vengono mai inviate a server diversi dai provider AI ufficiali."},
  ]},
  {id:"opere",e:"📚",t:"Opere",items:[
    {h:"Struttura",b:"Opera → Capitoli → Sezioni. Nessun limite di parole. Ogni sezione ha un editor completo con autosave e analisi AI dedicata."},
    {h:"Analisi critica",b:"Ogni sezione può ricevere una critica letteraria e filosofica completa calibrata sul tuo profilo."},
  ]},
  {id:"timer",e:"⏱️",t:"Timer & Pomodoro",items:[
    {h:"Tempo attivo",b:"Chief Editor traccia il tempo di scrittura effettivo con pausa automatica dopo 4 secondi di inattività. Visibile in STATS."},
    {h:"Countdown",b:"Clicca Timer nella barra sopra l'editor per impostare un countdown da 1 a 180 minuti."},
    {h:"Pomodoro",b:"Sessioni alternate Focus/Pausa configurabili. Focus: 5-60 minuti. Pausa: 1-30 minuti. Il contatore mostra i cicli completati."},
  ]},
];
---
<Base title="Aiuto" description="Guida completa a Chief Editor — funzionalità, BYOK, AI critica letteraria">
<div class="container help-page">
  <div class="help-header">
    <h1>Guida a Chief Editor</h1>
    <p class="help-intro">"Ogni grande scrittore ha avuto un editor esigente. Chief Editor è il tuo."</p>
  </div>

  <div class="help-toc">
    {sections.map(s=>(
      <a href={`#${s.id}`} class="toc-item">
        <span>{s.e}</span>
        <span>{s.t}</span>
      </a>
    ))}
  </div>

  {sections.map(s=>(
    <section id={s.id} class="help-section">
      <h2 class="help-section-title"><span>{s.e}</span>{s.t}</h2>
      <div class="help-items">
        {s.items.map(item=>(
          <div class="help-item">
            <h3>{item.h}</h3>
            <p>{item.b}</p>
          </div>
        ))}
      </div>
    </section>
  ))}

  <div class="help-downloads">
    <h2>Scarica le guide complete</h2>
    <div class="guide-btns">
      <a href="/docs/chief-editor-guida-completa.docx" class="guide-btn" download>📗 Guida Completa (.docx)</a>
      <a href="/docs/chief-editor-guida-avanzata.docx" class="guide-btn" download>📘 Guida Avanzata — critica letteraria (.docx)</a>
      <a href="/docs/chief-editor-tutorial.docx" class="guide-btn" download>📙 Tutorial Configurazione (.docx)</a>
    </div>
  </div>
</div>
</Base>

<style>
.help-page{padding:4rem 1.5rem 5rem;max-width:820px;}
.help-header{margin-bottom:2.5rem;}
.help-header h1{font-family:var(--font-serif);font-size:2.5rem;color:var(--text);margin-bottom:.6rem;}
.help-intro{color:var(--sub);font-style:italic;font-size:1.05rem;}
.help-toc{display:flex;flex-wrap:wrap;gap:.5rem;margin-bottom:3rem;padding:1.25rem;background:var(--surf);border:1px solid var(--border2);border-radius:12px;}
.toc-item{display:flex;align-items:center;gap:.4rem;padding:.35rem .75rem;border-radius:8px;font-size:.85rem;color:var(--text2);text-decoration:none;transition:all .2s;}
.toc-item:hover{background:rgba(124,58,237,.1);color:var(--vio3);}
.help-section{margin-bottom:3rem;padding-top:2rem;border-top:1px solid var(--border);}
.help-section:first-of-type{border-top:none;padding-top:0;}
.help-section-title{font-family:var(--font-serif);font-size:1.5rem;color:var(--text);margin-bottom:1.5rem;display:flex;align-items:center;gap:.6rem;}
.help-items{display:flex;flex-direction:column;gap:1rem;}
.help-item{padding:1rem 1.25rem;background:var(--surf);border:1px solid var(--border);border-radius:10px;}
.help-item h3{font-size:.9rem;font-weight:600;color:var(--vio3);margin-bottom:.4rem;font-family:var(--font-sans);}
.help-item p{font-size:.9rem;color:var(--text2);line-height:1.7;margin:0;}
.help-downloads{margin-top:3rem;padding:1.5rem;background:rgba(124,58,237,.06);border:1px solid rgba(196,181,253,.15);border-radius:14px;}
.help-downloads h2{font-family:var(--font-serif);font-size:1.3rem;color:var(--text);margin-bottom:1rem;}
.guide-btns{display:flex;flex-wrap:wrap;gap:.75rem;}
.guide-btn{display:inline-flex;align-items:center;gap:.5rem;background:var(--surf);border:1px solid var(--border2);color:var(--text2);border-radius:9px;padding:.6rem 1.1rem;font-size:.875rem;text-decoration:none;transition:all .2s;}
.guide-btn:hover{border-color:rgba(196,181,253,.3);color:var(--vio3);}
</style>
