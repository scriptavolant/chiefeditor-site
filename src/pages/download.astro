---
import Base from '../layouts/Base.astro';
---
<Base title="Download — Chief Editor Beta v1.0.7">
<div class="container dlpage">
  <h1>Download Chief Editor</h1>
  <p class="dlsub">Beta v1.0.7 — Windows, macOS, Linux</p>
  <div class="dl-cards">
    <div class="dl-card">
      <div class="dl-icon">🪟</div>
      <h2>Windows</h2>
      <p>Windows 10 / 11 · 64-bit</p>
      <div class="dl-buttons">
        <a href="/downloads/chief-editor-setup-1.0.7.exe" class="dl-primary" download>Scarica .exe</a>
        <a href="/downloads/chief-editor-1.0.7.msi" class="dl-secondary" download>.msi</a>
      </div>
    </div>
    <div class="dl-card">
      <div class="dl-icon">🍎</div>
      <h2>macOS</h2>
      <p>Intel · Apple Silicon</p>
      <div class="dl-buttons">
        <a href="/downloads/chief-editor-1.0.7.dmg" class="dl-primary" download>Scarica .dmg</a>
      </div>
    </div>
    <div class="dl-card">
      <div class="dl-icon">🐧</div>
      <h2>Linux</h2>
      <p>x64 · AppImage / deb</p>
      <div class="dl-buttons">
        <a href="/downloads/chief-editor-1.0.7.AppImage" class="dl-primary" download>AppImage</a>
        <a href="/downloads/chief-editor-1.0.7.deb" class="dl-secondary" download>.deb</a>
      </div>
    </div>
  </div>
  <div class="donate-box">
    <h2>Supporta il progetto</h2>
    <p>Chief Editor è gratuito e open source. Se ti piace, considera una donazione per supportare lo sviluppo!</p>
    <a href="https://www.paypal.com/donate?hosted_button_id=YOUR_PAYPAL_BUTTON_ID" class="donate-btn" target="_blank" rel="noopener">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M7.076 21.337H2.47a.641.641 0 0 1-.633-.74L4.944.901C5.026.382 5.474 0 5.998 0h7.46c2.57 0 4.578.543 5.622 1.566 1.035.974 1.481 2.408 1.34 3.948-.173 1.92-.98 3.181-2.19 4.15-.883.712-1.988 1.19-3.087 1.565-1.827.625-3.691 1.062-5.173 1.514-.264.081-.521.15-.767.21a.64.64 0 0 1-.267 0c-.265-.06-.522-.129-.767-.21-1.482-.452-3.346-.889-5.173-1.514-1.099-.375-2.204-.853-3.087-1.565C.645 6.615-.162 5.354 0 3.434.141 1.894.587.46 1.622.486 2.666.512 4.674.055 7.244.055h7.46c.524 0 .972.382 1.054.901l3.107 19.696a.641.641 0 0 1-.633.74H16.92c-.446 0-.84-.37-.934-.813a.638.638 0 0 1 .063-.362l1.348-6.956c.042-.216.055-.333.055-.333.117-.665.117-1.176 0-1.519-.426-1.235-1.744-1.635-3.146-1.635h-4.49c-.45 0-.84.37-.934.813a.638.638 0 0 1 .063.362l1.348 6.956c.042.216.055.333.055.333.117.665.117 1.176 0 1.519-.426 1.235-1.744 1.635-3.146 1.635H7.076z"/>
      </svg>
      Dona con PayPal
    </a>
  </div>
  <div class="dl-note">
    <h2>Cosa serve per usarlo</h2>
    <p>Chief Editor è BYOK (Bring Your Own Key): hai bisogno di almeno una chiave API di un provider AI. Consigliamo <strong>Anthropic Claude</strong> per la critica letteraria. Costo indicativo: 2-5€ al mese per uso quotidiano intensivo.</p>
    <a href="/aiuto#byok" class="dl-guide">Guida alla configurazione →</a>
  </div>
</div>
</Base>
<style>
.dlpage{padding:4rem 1.5rem 5rem;}
.dlpage h1{font-family:var(--font-serif);font-size:2.5rem;color:var(--text);margin-bottom:.5rem;}
.dlsub{color:var(--sub);font-size:1.05rem;margin-bottom:3rem;}
.dl-cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:1.25rem;margin-bottom:3rem;}
.dl-card{background:var(--surf);border:1px solid var(--border2);border-radius:14px;padding:2rem;text-align:center;}
.dl-icon{font-size:2.5rem;margin-bottom:1rem;}
.dl-card h2{font-family:var(--font-sans);font-size:1.1rem;font-weight:700;color:var(--text);margin-bottom:.35rem;}
.dl-card p{font-size:.85rem;color:var(--sub);margin-bottom:1.25rem;}
.dl-buttons{display:flex;gap:.5rem;justify-content:center;flex-wrap:wrap;}
.dl-primary{background:linear-gradient(135deg,var(--vio),var(--vio2));color:#fff;border-radius:8px;padding:.55rem 1.1rem;font-size:.875rem;font-weight:600;text-decoration:none;transition:opacity .2s;}
.dl-primary:hover{opacity:.88;color:#fff;}
.dl-secondary{background:var(--surf2);border:1px solid var(--border2);color:var(--text2);border-radius:8px;padding:.55rem 1rem;font-size:.875rem;text-decoration:none;transition:all .2s;}
.dl-secondary:hover{border-color:rgba(196,181,253,.3);color:var(--vio3);}
.dl-note{background:rgba(124,58,237,.06);border:1px solid rgba(196,181,253,.15);border-radius:14px;padding:2rem;}
.dl-note h2{font-family:var(--font-serif);font-size:1.3rem;color:var(--text);margin-bottom:.75rem;}
.dl-note p{font-size:.95rem;color:var(--text2);line-height:1.7;margin-bottom:1rem;}
.dl-guide{color:var(--vio3);font-size:.9rem;font-weight:500;}
</style>
