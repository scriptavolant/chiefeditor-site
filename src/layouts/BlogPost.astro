---
import Base from './Base.astro';
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  tags?: string[];
  series?: string;
  seriesOrder?: number;
}
const { title, description, pubDate, updatedDate, heroImage, tags = [], series, seriesOrder } = Astro.props;
function formatDate(d: Date) {
  return d.toLocaleDateString('it-IT', { day: 'numeric', month: 'long', year: 'numeric' });
}
---
<Base title={title} description={description} image={heroImage}>
<article class="post-page">

  {heroImage && (
    <div class="post-hero-img">
      <img src={heroImage} alt="" loading="eager" />
    </div>
  )}

  <div class="container post-container">
    <header class="post-header">
      {series && (
        <a href={`/serie/${series.toLowerCase().replace(/\s+/g,'-')}`} class="post-series-badge">
          Serie: {series}{seriesOrder ? ` · #${seriesOrder}` : ''}
        </a>
      )}
      <h1 class="post-title">{title}</h1>
      <p class="post-desc">{description}</p>
      <div class="post-byline">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {updatedDate && (
          <span class="post-updated">
            Aggiornato il <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>
          </span>
        )}
        {tags.length > 0 && (
          <div class="post-tags">
            {tags.map(t => <a href={`/tag/${t}`} class="tag">{t}</a>)}
          </div>
        )}
      </div>
    </header>

    <div class="post-body prose">
      <slot />
    </div>

    <footer class="post-footer">
      <a href="/blog" class="post-back">← Tutti gli articoli</a>
      <a href="https://www.paypal.com/donate?hosted_button_id=YOUR_PAYPAL_BUTTON_ID" class="post-donate" target="_blank" rel="noopener">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M7.076 21.337H2.47a.641.641 0 0 1-.633-.74L4.944.901C5.026.382 5.474 0 5.998 0h7.46c2.57 0 4.578.543 5.622 1.566 1.035.974 1.481 2.408 1.34 3.948-.173 1.92-.98 3.181-2.19 4.15-.883.712-1.988 1.19-3.087 1.565-1.827.625-3.691 1.062-5.173 1.514-.264.081-.521.15-.767.21a.64.64 0 0 1-.267 0c-.265-.06-.522-.129-.767-.21-1.482-.452-3.346-.889-5.173-1.514-1.099-.375-2.204-.853-3.087-1.565C.645 6.615-.162 5.354 0 3.434.141 1.894.587.46 1.622.486 2.666.512 4.674.055 7.244.055h7.46c.524 0 .972.382 1.054.901l3.107 19.696a.641.641 0 0 1-.633.74H16.92c-.446 0-.84-.37-.934-.813a.638.638 0 0 1 .063-.362l1.348-6.956c.042-.216.055-.333.055-.333.117-.665.117-1.176 0-1.519-.426-1.235-1.744-1.635-3.146-1.635h-4.49c-.45 0-.84.37-.934.813a.638.638 0 0 1 .063.362l1.348 6.956c.042.216.055.333.055.333.117.665.117 1.176 0 1.519-.426 1.235-1.744 1.635-3.146 1.635H7.076z"/>
        </svg>
        Supporta il progetto
      </a>
    </footer>
  </div>
</article>
</Base>

<style>
.post-hero-img {
  width: 100%;
  max-height: 420px;
  overflow: hidden;
  border-bottom: 1px solid var(--border);
}
.post-hero-img img {
  width: 100%;
  height: 420px;
  object-fit: cover;
}
.post-container {
  max-width: 740px;
  padding: 3rem 1.5rem 5rem;
}
.post-series-badge {
  display: inline-block;
  font-size: 0.775rem;
  font-weight: 600;
  color: var(--vio3);
  background: rgba(124,58,237,0.1);
  border: 1px solid rgba(196,181,253,0.2);
  border-radius: 20px;
  padding: 3px 11px;
  margin-bottom: 1rem;
  text-decoration: none;
}
.post-title {
  font-size: clamp(1.75rem, 4vw, 2.75rem);
  font-weight: 900;
  color: var(--text);
  line-height: 1.1;
  letter-spacing: -0.025em;
  margin-bottom: 0.75rem;
}
.post-desc {
  font-size: 1.1rem;
  color: var(--sub);
  line-height: 1.65;
  margin-bottom: 1.25rem;
  font-style: italic;
}
.post-byline {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.75rem;
  padding-bottom: 2rem;
  border-bottom: 1px solid var(--border);
  margin-bottom: 2.5rem;
}
.post-byline time { font-size: 0.85rem; color: var(--sub); }
.post-updated { font-size: 0.8rem; color: var(--sub); }
.post-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; }
.post-body { font-size: 1.0625rem; }
.post-footer {
  margin-top: 3rem;
  padding-top: 1.5rem;
  border-top: 1px solid var(--border);
}
.post-back {
  font-size: 0.875rem;
  color: var(--sub);
  text-decoration: none;
}
.post-back:hover { color: var(--vio3); }
.post-donate {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  font-size: 0.8rem;
  color: var(--sub);
  text-decoration: none;
  margin-left: auto;
  padding: 0.4rem 0.8rem;
  border-radius: 6px;
  background: rgba(34,197,94,0.1);
  border: 1px solid rgba(34,197,94,0.2);
  transition: all 0.2s;
}
.post-donate:hover {
  color: #16a34a;
  background: rgba(34,197,94,0.15);
  border-color: rgba(34,197,94,0.3);
}
</style>
