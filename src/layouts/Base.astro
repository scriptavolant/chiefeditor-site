        </svg>
      </a>
          <a href="https://fabiomasetti.bsky.social" target="_blank" rel="noopener" aria-label="Bluesky" class="social-link">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.768c0 .69.378 5.65.624 6.479.815 2.736 3.713 3.66 6.383 3.364.136-.02.275-.039.415-.056-.138.022-.276.04-.415.056-3.912.58-7.387 2.005-2.83 7.078 5.013 5.19 6.87-1.113 7.823-4.308.953 3.195 2.05 9.271 7.733 4.308 4.267-4.308 1.172-6.498-2.74-7.078a8.741 8.741 0 0 1-.415-.056c.14.017.279.036.415.056 2.67.297 5.568-.628 6.383-3.364.246-.828.624-5.79.624-6.478 0-.69-.139-1.861-.902-2.204-.659-.299-1.664-.62-4.3 1.24C16.046 4.748 13.087 8.687 12 10.8z"/>
        </svg>
      </a>
      <a href="https://linkedin.com/in/fabiomasetti" target="_blank" rel="noopener" aria-label="LinkedIn" class="social-link">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
      </a>
      <a href="https://linktr.ee/fabio.masetti" target="_blank" rel="noopener" aria-label="Linktree" class="social-link">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M13.11 5.71l4.06 4.06-1.42 1.42-2.64-2.65v4.54h-2V8.54L8.47 11.2 7.05 9.77l4.06-4.06L12 4.82l1.11.89zM10.06 13.5h3.88v1.88h-3.88V13.5zm.94 3h2v3.68h-2V16.5z"/>
        </svg>
      </a>
    </div>
  </div>
</footer>

<!-- COOKIE CONSENT BANNER -->
<div id="cookie-banner" class="cookie-banner" role="dialog" aria-label="Preferenze cookie" aria-live="polite" hidden>
  <div class="cookie-inner container">
    <div class="cookie-text">
      <strong>Questo sito usa i cookie</strong>
      <p>
        Utilizziamo cookie tecnici necessari al funzionamento del sito e, previo tuo consenso,
        cookie analitici (Google Analytics) per capire come viene usato il sito in forma aggregata
        e anonimizzata. Non utilizziamo cookie di profilazione pubblicitaria.
      </p>
      <a href="/privacy" class="cookie-link">Privacy Policy</a>
    </div>
    <div class="cookie-actions">
      <button id="cookie-reject" class="cookie-btn cookie-btn--secondary" type="button">Solo tecnici</button>
      <button id="cookie-accept" class="cookie-btn cookie-btn--primary" type="button">Accetta tutti</button>
    </div>
  </div>
</div>

<script>
// Mobile menu toggle
const burger = document.getElementById('nav-burger');
const menu = document.getElementById('mobile-menu');
burger?.addEventListener('click', () => {
  const open = burger.getAttribute('aria-expanded') === 'true';
  burger.setAttribute('aria-expanded', String(!open));
  menu?.setAttribute('aria-hidden', String(open));
  document.body.classList.toggle('menu-open', !open);
});
// Close menu on link click
menu?.querySelectorAll('a').forEach(a => {
  a.addEventListener('click', () => {
    burger?.setAttribute('aria-expanded', 'false');
    menu.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('menu-open');
  });
});
// Sticky nav shadow
const nav = document.getElementById('nav');
window.addEventListener('scroll', () => {
  nav?.classList.toggle('scrolled', window.scrollY > 20);
}, { passive: true });

// ── Cookie consent ──────────────────────────────────────────────────────────
// Replace G-XXXXXXXXXX with your actual Google Analytics Measurement ID
const GA_ID = import.meta.env.PUBLIC_GA_ID || '';
const CONSENT_KEY = 'ce_cookie_consent';

function loadGA() {
  if (!GA_ID || document.getElementById('ga-script')) return;
  const s = document.createElement('script');
  s.id = 'ga-script';
  s.async = true;
  s.src = `https://www.googletagmanager.com/gtag/js?id=${GA_ID}`;
  document.head.appendChild(s);
  (window as any).dataLayer = (window as any).dataLayer || [];
  function gtag(...args: any[]) { (window as any).dataLayer.push(args); }
  gtag('js', new Date());
  gtag('config', GA_ID, { anonymize_ip: true });
}

function hideCookieBanner() {
  const banner = document.getElementById('cookie-banner');
  if (!banner) return;
  banner.classList.remove('visible');
  setTimeout(() => banner.setAttribute('hidden', ''), 380);
}

function showCookieBanner() {
  const banner = document.getElementById('cookie-banner');
  if (!banner) return;
  banner.removeAttribute('hidden');
  requestAnimationFrame(() => requestAnimationFrame(() => banner.classList.add('visible')));
}

function initCookieBanner() {
  const consent = localStorage.getItem(CONSENT_KEY);
  if (consent === 'accepted') { loadGA(); return; }
  if (consent === 'rejected') return;
  showCookieBanner();

  document.getElementById('cookie-accept')?.addEventListener('click', () => {
    localStorage.setItem(CONSENT_KEY, 'accepted');
    loadGA();
    hideCookieBanner();
  });
  document.getElementById('cookie-reject')?.addEventListener('click', () => {
    localStorage.setItem(CONSENT_KEY, 'rejected');
    hideCookieBanner();
  });
}

document.getElementById('cookie-settings')?.addEventListener('click', () => {
  localStorage.removeItem(CONSENT_KEY);
  showCookieBanner();
  document.getElementById('cookie-accept')?.addEventListener('click', () => {
    localStorage.setItem(CONSENT_KEY, 'accepted');
    loadGA();
    hideCookieBanner();
  }, { once: true });
  document.getElementById('cookie-reject')?.addEventListener('click', () => {
    localStorage.setItem(CONSENT_KEY, 'rejected');
    hideCookieBanner();
  }, { once: true });
});

initCookieBanner();
</script>

<style>
/* ── NAV ── */
.nav-wrap {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(10,10,16,0.85);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-bottom: 1px solid transparent;
  transition: border-color 0.3s, box-shadow 0.3s;
}
.nav-wrap.scrolled {
  border-color: var(--border);
  box-shadow: 0 4px 24px rgba(0,0,0,0.4);
}
.nav-inner {
  display: flex;
  align-items: center;
  gap: 2rem;
  height: 64px;
}
.nav-logo {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  text-decoration: none;
  flex-shrink: 0;
}
.nav-logo-text {
  font-family: var(--font-serif);
  font-size: 1.1rem;
  color: var(--text);
  font-style: normal;
}
.nav-logo-text em {
  color: var(--vio3);
  font-style: italic;
}
.nav-links {
  display: flex;
  list-style: none;
  gap: 0.25rem;
  margin: 0 auto;
}
.nav-link {
  display: block;
  padding: 0.4rem 0.85rem;
  border-radius: 8px;
  font-size: 0.875rem;
  font-weight: 500;
  color: var(--sub);
  text-decoration: none;
  transition: all 0.2s;
  letter-spacing: 0.01em;
}
.nav-link:hover { color: var(--text2); background: rgba(255,255,255,0.04); }
.nav-link.active { color: var(--vio3); background: rgba(124,58,237,0.1); }
.nav-cta {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  background: linear-gradient(135deg, var(--vio), var(--vio2));
  color: #fff;
  border-radius: 8px;
  padding: 0.45rem 1rem;
  font-size: 0.825rem;
  font-weight: 600;
  text-decoration: none;
  flex-shrink: 0;
  transition: opacity 0.2s, transform 0.2s;
}
.nav-cta:hover { opacity: 0.9; transform: translateY(-1px); color: #fff; }
.nav-burger {
  display: none;
  flex-direction: column;
  gap: 5px;
  background: none;
  border: none;
  cursor: pointer;
  padding: 4px;
  margin-left: auto;
}
.nav-burger span {
  display: block;
  width: 22px;
  height: 2px;
  background: var(--text2);
  border-radius: 2px;
  transition: all 0.25s;
}

/* Mobile menu */
.mobile-menu {
  position: fixed;
  inset: 64px 0 0 0;
  background: rgba(10,10,16,0.97);
  backdrop-filter: blur(20px);
  z-index: 99;
  display: none;
  padding: 2rem 1.5rem;
}
.mobile-menu[aria-hidden="false"] { display: block; }
.mobile-menu ul { list-style: none; }
.mobile-link, .mobile-download {
  display: block;
  font-size: 1.25rem;
  font-family: var(--font-serif);
  color: var(--text2);
  padding: 0.85rem 0;
  border-bottom: 1px solid var(--border);
  text-decoration: none;
}
.mobile-link:hover { color: var(--vio3); }
.mobile-download {
  margin-top: 1rem;
  color: var(--vio3);
  border-color: transparent;
  font-family: var(--font-sans);
  font-size: 1rem;
}

/* ── FOOTER ── */
.footer {
  border-top: 1px solid var(--border);
  padding: 3rem 0 2rem;
  margin-top: 5rem;
}
.footer-inner {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 2rem;
  flex-wrap: wrap;
}
.footer-logo {
  font-family: var(--font-serif);
  font-size: 1.25rem;
  color: var(--text);
  text-decoration: none;
  display: block;
  margin-bottom: 0.5rem;
}
.footer-logo em { color: var(--vio3); font-style: italic; }
.footer-tagline { font-size: 0.875rem; color: var(--sub); margin-bottom: 0.75rem; }
.footer-copy { font-size: 0.8rem; color: var(--sub); margin-bottom: 0.4rem; }
.footer-privacy { font-size: 0.8rem; color: var(--sub); text-decoration: underline; }
.footer-privacy:hover { color: var(--vio3); }
.footer-cookie-btn {
  background: none;
  border: none;
  cursor: pointer;
  padding: 0;
  font-family: inherit;
  text-decoration: underline;
}

/* ── Cookie banner ── */
.cookie-banner {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 200;
  background: rgba(18,18,28,0.97);
  border-top: 1px solid var(--border2);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  transform: translateY(100%);
  transition: transform 0.38s cubic-bezier(0.22,1,0.36,1);
}
.cookie-banner.visible { transform: translateY(0); }
.cookie-inner {
  display: flex;
  align-items: center;
  gap: 2rem;
  padding: 1.25rem 1.5rem;
  flex-wrap: wrap;
}
.cookie-text { flex: 1; min-width: 260px; }
.cookie-text strong { display: block; font-size: 0.9rem; color: var(--text); margin-bottom: 0.35rem; }
.cookie-text p { font-size: 0.8rem; color: var(--sub); line-height: 1.55; margin-bottom: 0.4rem; }
.cookie-link { font-size: 0.78rem; color: var(--vio3); text-decoration: underline; }
.cookie-actions {
  display: flex;
  gap: 0.6rem;
  flex-shrink: 0;
  flex-wrap: wrap;
}
.cookie-btn {
  border: none;
  border-radius: 8px;
  padding: 0.5rem 1.1rem;
  font-size: 0.85rem;
  font-weight: 600;
  cursor: pointer;
  transition: opacity 0.2s, transform 0.2s;
  font-family: inherit;
  white-space: nowrap;
}
.cookie-btn:hover { opacity: 0.85; transform: translateY(-1px); }
.cookie-btn--primary {
  background: linear-gradient(135deg, var(--vio), var(--vio2));
  color: #fff;
}
.cookie-btn--secondary {
  background: var(--surf2);
  border: 1px solid var(--border2);
  color: var(--text2);
}
@media (max-width: 640px) {
  .cookie-inner { flex-direction: column; gap: 1rem; }
  .cookie-actions { width: 100%; justify-content: flex-end; }
}
.footer-social {
  display: flex;
  gap: 0.75rem;
  align-items: center;
}
.social-link {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  border-radius: 8px;
  background: var(--surf2);
  border: 1px solid var(--border2);
  color: var(--sub);
  transition: all 0.2s;
}
.social-link:hover {
  background: rgba(124,58,237,0.15);
  border-color: rgba(196,181,253,0.3);
  color: var(--vio3);
  transform: translateY(-2px);
}

/* ── Responsive ── */
@media (max-width: 768px) {
  .nav-links, .nav-cta { display: none; }
  .nav-burger { display: flex; }
  .nav-inner { gap: 0; }
}
</style>
