        </svg>
      </a>
      <a href="https://www.instagram.com/fabiomasetti/" target="_blank" rel="noopener" aria-label="Instagram" class="social-link">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
